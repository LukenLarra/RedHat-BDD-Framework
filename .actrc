# act configuration file
# https://github.com/nektos/act

# Use a larger image to match GitHub Actions environment more closely
--platform ubuntu-latest=catthehacker/ubuntu:act-latest

# Set container architecture
--container-architecture linux/amd64

# Verbose output for debugging (remove if too noisy)
#--verbose

# Shared Docker network so the act runner and manually started containers
# (e.g. testdb) can communicate by container name.
--network act_network

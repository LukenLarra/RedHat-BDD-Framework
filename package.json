{
  "name": "redhat-bdd-framework",
  "version": "1.0.0",
  "description": "Stack-Agnostic BDD Testing Framework",
  "scripts": {
    "test": "python bdd_framework.py --config framework.yml",
    "test:ci": "python bdd_framework.py --config framework.yml --profile ci",
    "test:debug": "python bdd_framework.py --config framework.yml --profile debug",
    "test:smoke": "python bdd_framework.py --config framework.yml --tags @smoke",
    "install:all": "npm install && npm run install:backend && npm run install:frontend && npm run install:tests && npm run install:framework && npm run install:dev",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "install:tests": "cd tests && pip install -r requirements.txt",
    "install:framework": "pip install -r requirements.txt",
    "install:dev": "pip install -r requirements-dev.txt && pre-commit install",
    "format": "npm run format:python && npm run format:js",
    "format:python": "black . && isort .",
    "format:js": "prettier --write \"frontend/**/*.{js,json,css,html}\"",
    "lint": "npm run lint:python && npm run lint:js",
    "lint:python": "flake8 .",
    "lint:js": "prettier --check \"frontend/**/*.{js,json,css,html}\"",
    "precommit": "pre-commit run --all-files"
  },
  "keywords": [
    "bdd",
    "testing",
    "behave",
    "framework"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "markdownlint-cli": "^0.47.0",
    "prettier": "^3.2.4"
  }
}
